# Frontend — proxy nginx → backend
BACKEND_HOST=eficienciia   # Service Name do backend no Easypanel
BACKEND_PORT=4000          # Porta que o backend escuta (deve bater com PORT do backend)

# Banco de dados (MySQL no Easypanel)
DB_HOST=easypanel.eficienciia.com.br
DB_PORT=3306
DB_USER=mysql
DB_PASSWORD=
DB_NAME=daily

# WAHA (WhatsApp API no Easypanel)
# Usar nome interno do container na rede Docker do Easypanel
WAHA_URL=http://eficienciia_waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=
