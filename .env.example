# ============================================
# DB & AUTH (Server Side Only)
# ============================================
DATABASE_URL=mysql://user:password@host:3306/daily
JWT_SECRET=sua_chave_secreta_jwt_aqui

# ============================================
# PAYMENT PROVIDERS (Server Side Only)
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
HOTMART_TOKEN=hottok_valor_do_seu_token

# ============================================
# WAHA WHATSAPP API (Server Side Only)
# ============================================
WAHA_BASE_URL=https://sua-instancia-waha.com
WAHA_API_KEY=sua_chave_opcional_aqui

# ============================================
# PUBLIC VARIABLES (Exposed to Frontend)
# ============================================
# Prefixe com NEXT_PUBLIC_ se precisar acessar no client
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Deve ser igual a WAHA_BASE_URL — necessário para validação client-side
NEXT_PUBLIC_WAHA_BASE_URL=https://sua-instancia-waha.com
