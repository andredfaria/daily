# =========================
# Shared runtime (Docker + EasyPanel)
# Use this single file as source for frontend, backend and Supabase integration values.
# =========================

# ---- Frontend/Reverse Proxy ----
FRONTEND_PORT=80
BACKEND_HOST=backend
BACKEND_PORT=4000

# ---- Backend runtime ----
NODE_ENV=production
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=daily

# ---- WAHA integration (backend + Supabase Edge Functions) ----
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=

# ---- Supabase client (frontend/Vite) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase server secrets (Edge Functions only) ----
# Never expose this in the frontend bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
